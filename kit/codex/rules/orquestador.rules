prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Sólo el usuario puede ejecutar git push.",
    match = ["git push", "git push origin main", "git push --force-with-lease"],
)

prefix_rule(
    pattern = ["git.exe", "push"],
    decision = "forbidden",
    justification = "Sólo el usuario puede ejecutar git push.",
    match = ["git.exe push origin main"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Los commits requieren un pedido explícito del usuario.",
    match = ["git commit -m cambio", "git commit --amend"],
)

prefix_rule(
    pattern = ["git.exe", "commit"],
    decision = "prompt",
    justification = "Los commits requieren un pedido explícito del usuario.",
    match = ["git.exe commit -m cambio"],
)

# --- Segunda capa: formas que evaden el prefix match simple -----------------
# `git -C <dir> push` y `git --git-dir=<x> push` NO matchean ["git","push"],
# porque el prefijo de argv arranca con la opcion. execpolicy solo expresa
# prefijos (no hay regex), asi que estas formas se marcan `prompt`: bajo
# `codex exec` no hay TTY para aprobarlas, y el hook git-guard las deniega.
# Ver README.md seccion 8.

prefix_rule(
    pattern = ["git", "-C"],
    decision = "prompt",
    justification = "git -C puede ocultar un push; requiere aprobacion explicita.",
    match = ["git -C . push origin main", "git -C sub status"],
)

prefix_rule(
    pattern = ["git.exe", "-C"],
    decision = "prompt",
    justification = "git -C puede ocultar un push; requiere aprobacion explicita.",
    match = ["git.exe -C . push origin main"],
)

prefix_rule(
    pattern = ["git", "--git-dir"],
    decision = "prompt",
    justification = "--git-dir puede ocultar un push; requiere aprobacion explicita.",
    match = ["git --git-dir .git push"],
)

prefix_rule(
    pattern = ["git", "--work-tree"],
    decision = "prompt",
    justification = "--work-tree puede ocultar un push; requiere aprobacion explicita.",
    match = ["git --work-tree . push"],
)
