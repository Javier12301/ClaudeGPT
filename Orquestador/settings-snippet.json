{
  "_comment": "Mergear estas claves en ~/.claude/settings.json. No reemplaza el archivo: agrega lo que falte y fusiona permissions.deny con lo que ya tengas. statusLine requiere clonar ClaudeCodeStatusLine en ~/.claude/statusline y copiar statusline-wrapper.ps1 a ~/.claude/ (ver INSTALL.md 4.5). El hook git-guard requiere copiar hooks/git-guard.ps1 a ~/.claude/hooks/ (ver INSTALL-HIBRIDO.md).",
  "attribution": {
    "commits": false,
    "pullRequests": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git.exe push:*)"
    ],
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude/scripts/codex-run.ps1:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude/hooks/git-guard.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ~/.claude/statusline-wrapper.ps1"
  },
  "model": "opus",
  "effortLevel": "medium",
  "enabledPlugins": {
    "engram@engram": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": { "source": "github", "repo": "Gentleman-Programming/engram" }
    },
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    }
  }
}
